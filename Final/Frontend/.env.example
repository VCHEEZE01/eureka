# .env.local로 복사해 사용하세요. 공개 설정만 넣습니다(API 비밀키 금지).
# Next 화면의 기본값은 실제 API입니다. 빈 주소는 같은 origin의 /problems를 조회합니다.
NEXT_PUBLIC_API_BASE=http://localhost:8000
NEXT_PUBLIC_DATA_MODE=live

# 명시적으로 예시 화면이 필요할 때만 NEXT_PUBLIC_DATA_MODE=demo
# 기준 단일 HTML은 npm run build:single -- --data <Problem[] JSON> --mode published|review
