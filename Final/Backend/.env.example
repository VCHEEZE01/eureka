# 이 파일을 .env 로 복사해서 값을 채우세요. .env 는 깃에 올리지 않습니다.

# 네이버 검색 API (NAVER API HUB에서 발급, 실제 요금·한도는 콘솔 확인)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 카카오 다음 검색 API (Kakao Developers에서 발급, 무료)
KAKAO_REST_API_KEY=

# 공공데이터포털 (활용 신청 필요)
PUBLIC_DATA_KEY=

# ── LLM (포텐스닷 게이트웨이) ─────────────────────────
# BASE_URL과 REQUEST_STYLE은 포텐스닷 문서를 보고 채운다.
LLM_PROVIDER=potens              # potens | gemini | echo
# Gemini 사용 시 provider=gemini. 아래 키는 포텐스닷 설정과 별도로 사용한다.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# 상세 정보 생성: scripts/build_problems.py (공개 저장은 별도 사람 검수 필요)
# PROBLEMS_DIR=data/problems
# API_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# ★ 포텐스닷 엔드포인트
LLM_BASE_URL=
LLM_API_KEY=
# Claude Opus 계열 모델 식별자
LLM_MODEL=
# 비우면 LLM_MODEL. 판별만 싼 모델로 내릴 때
LLM_MODEL_JUDGE=
LLM_AUTH_HEADER=Authorization
LLM_AUTH_SCHEME=Bearer           # 빈 문자열이면 키를 그대로 넣는다
LLM_REQUEST_STYLE=openai_chat    # openai_chat | anthropic_messages | raw_prompt
# raw_prompt일 때 응답 본문 경로 (예: data.message)
LLM_RESPONSE_PATH=
LLM_TIMEOUT_SEC=60
LLM_MAX_RETRIES=2
LLM_DRY_RUN=false                # 실제 타겟 수집은 false 필수. 테스트·CI는 격리 fixture 사용

# ── 수집 (① 수집 에이전트) ───────────────────────────
# 주 1회 배치만 돌므로 배치일 하루치 한도를 다 써도 된다.
NAVER_DAILY_CAP=20000            # 서비스 한도와 별개인 로컬 일일 안전 상한
KAKAO_DAILY_CAP=25000            # 서비스 한도와 별개인 로컬 일일 상한
COLLECT_PER_QUERY_LIMIT=100
COLLECT_MAX_PAGES=3              # 문서 4-1: 쿼리당 3페이지

# ── 온보딩 실시간 수집: 한 탐색의 운영 예산 ────────────
# 기본 120개 검색어에서 받은 자료는 같은 실행 안에서 배치별로 분석한다.
COLLECTION_QUERY_BUDGET=120
COLLECTION_ITEMS_PER_QUERY=20
COLLECTION_JUDGE_PER_CATEGORY=1000
COLLECTION_JUDGE_BUDGET=2400
COLLECTION_PROBLEM_BUDGET=20
COLLECTION_LLM_CALL_BUDGET=200
COLLECTION_TIMEOUT_SEC=3600

# ── 판별·묶기 (② 해석기) ────────────────────────────
JUDGE_BATCH_SIZE=20              # LLM 한 번에 넣을 건수
MAX_LLM_ITEMS=20000              # 주간 총량 하드 상한 (카테고리 5개 합산)
CLUSTER_BACKEND=tfidf            # tfidf | embedding | hash
CLUSTER_THRESHOLD_TFIDF=0.45     # 튜닝 시작점
CLUSTER_THRESHOLD_EMBED=0.80
MIN_GROUP_SIZE=5                 # 문서 6절: 유사한 글 5건 이상이면 후보

# ── 저장 ────────────────────────────────────────────
CORPUS_DIR=./data/corpus
CORPUS_KEEP_SNIPPET=true         # false면 판별·묶기 후 snippet을 비운다

# DB (정해지면 채우기. SQLite면 파일 경로)
DATABASE_URL=sqlite:///./eureka.db
