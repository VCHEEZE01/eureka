# 이 파일을 .env 로 복사해서 값을 채우세요. .env 는 깃에 올리지 않습니다.
#   PowerShell:  Copy-Item .env.example .env

# ─────────────────────────────────────────────────────────────
# 유레카 백엔드 환경변수 (v1: 트렌드 키워드 → 아이디어 생성)
#
# · 읽는 곳: app/config/settings.py (다른 파일은 os.environ 을 직접 읽지 않는다)
# · 이 파일(.env)은 .gitignore 에 등록돼 있어 커밋되지 않는다. 키는 여기에만 넣을 것.
# · 주석은 항상 "윗줄"에 달 것. `KEY=값  # 설명` 처럼 같은 줄에 달면 값으로 읽힐 수 있다.
# · 값을 바꾼 뒤에는 서버(uvicorn)를 다시 켜야 반영된다.
# ─────────────────────────────────────────────────────────────


# ══ [필수] LLM 연결 ═══════════════════════════════════════════

# 어떤 LLM을 쓸지. v1 아이디어 생성은 gemini 기준으로 구현·실측됐다.
#   gemini : Google Gemini (권장)
#   echo   : 네트워크 호출 없는 가짜 모델 → 항상 예시 아이디어
#   potens : 포텐스닷을 메인으로 (v0에서 쓰던 옛날 방식, 쓰려면 LLM_BASE_URL·LLM_API_KEY·
#            LLM_MODEL 필요) — 지금은 안 쓴다. 포텐스닷을 "Gemini 실패 시 백업"으로만
#            쓰려면 이 값은 gemini로 두고 아래 POTENS_API_KEY 쪽을 채울 것.
LLM_PROVIDER=gemini

# 실제 호출 여부.
#   true  : 호출하지 않음 → 항상 예시 아이디어 (응답 source: "fallback")
#   false : 실제 LLM 호출 (응답 source: "llm")
#           키가 비어 있거나 틀리면 오류 대신 예시 아이디어로 대체되고 서버 로그에 원인이 찍힌다.
LLM_DRY_RUN=false

# Google AI Studio(https://aistudio.google.com)에서 발급한 Gemini API 키.
# 따옴표 없이 키 문자열만 붙여넣을 것.
GEMINI_API_KEY=

# 사용할 Gemini 모델명.
# 호출 시 404(모델 없음)가 나면 AI Studio에서 쓸 수 있는 모델명으로 바꿀 것.
GEMINI_MODEL=gemini-3.5-flash-lite

# [선택] Gemini 백업(폴백). 무료 쿼터 소진 등으로 Gemini가 실패하면
# 자동으로 포텐스닷(Claude 모델)으로 한 번 더 시도한다.
# POTENS_API_KEY 를 비워두면 지금까지처럼 폴백 없이 그대로 실패한다.
# 저장소 최상위 docs/POTENS_API_사용법.md 참고.
# POTENS_API_KEY=
# POTENS_BASE_URL=https://ai.potens.ai
# POTENS_MODEL=claude-4-6-sonnet


# ══ [선택] 아이디어 생성 튜닝 — 주석 그대로 두면 괄호 안 기본값 ══

# 응답 최대 토큰 (기본 6000).
# 3000으로 낮췄을 때 아이디어 5개 생성에서 응답이 잘려 예시 아이디어로 빠진 이력이 있다.
# IDEA_LLM_MAX_TOKENS=6000

# 창의성 0.0~2.0. 높을수록 매번 다른 아이디어가 나온다 (기본 0.9).
# IDEA_LLM_TEMPERATURE=0.9

# LLM 한 번 호출을 기다리는 시간, 초 (기본 60).
# LLM_TIMEOUT_SEC=60

# 호출 실패 시 재시도 횟수 (기본 2).
# LLM_MAX_RETRIES=2


# ══ [미사용] v0 수집 파이프라인용 — 지금 v1 코드에서는 읽지 않는다 ══
# v0 코드(git tag v0-pre-pivot)를 다시 돌릴 때만 필요하다.

# 네이버 검색 오픈API (개발자센터 발급)
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=

# 카카오 다음 검색 API (Kakao Developers 발급)
# KAKAO_REST_API_KEY=

# 공공데이터포털 (활용 신청 필요)
# PUBLIC_DATA_KEY=


# ══ [선택] Supabase — 로그인 · 보관함 · 새로고침 제한 ══════════════
# 설정 순서는 바탕화면의 "유레카_Supabase_설정.html" 또는 db/README.md 참고.
# AUTH_ENABLED=false 면 아래 값이 비어 있어도 앱은 익명으로 정상 동작한다.
AUTH_ENABLED=false
SUPABASE_URL=
SUPABASE_ANON_KEY=
# ⚠ 아래 두 개는 서버 전용. 프론트·로그·깃 어디에도 넣지 말 것.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
