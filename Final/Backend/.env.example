# 이 파일을 .env 로 복사해서 값을 채우세요. .env 는 깃에 올리지 않습니다.

# 네이버 검색 오픈API (개발자센터에서 발급, 일 25,000회 무료)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 카카오 다음 검색 API (Kakao Developers에서 발급, 무료)
KAKAO_REST_API_KEY=

# 공공데이터포털 (활용 신청 필요)
PUBLIC_DATA_KEY=

# LLM (모델 정해지면 채우기)
LLM_API_KEY=

# DB (정해지면 채우기. SQLite면 파일 경로)
DATABASE_URL=sqlite:///./eureka.db
